<div class="container-fluid py-4">
    <h2 class="mb-4">Quản Lý Đội Ngũ Bác Sĩ</h2>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <input type="text" class="form-control" id="searchInput" placeholder="Tìm tên bác sĩ, email...">
          </div>
          <div class="col-md-3">
            <select class="form-select" id="statusFilter">
              <option value="">Tất cả trạng thái</option>
              <option value="true">Đã duyệt</option>
              <option value="false">Chờ duyệt</option>
            </select>
          </div>
          <div class="col-md-2">
            <button class="btn btn-primary w-100" onclick="loadDoctors()">
              <i class="fas fa-search me-2"></i>Tìm kiếm
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Thông tin bác sĩ</th>
                <th>Chuyên khoa</th>
                <th>Trạng thái duyệt</th>
                <th>Tài khoản</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="doctorsTableBody">
              <tr><td colspan="5" class="text-center py-3"><div class="spinner-border text-primary"></div></td></tr>
            </tbody>
          </table>
        </div>

        <nav class="mt-3">
            <ul class="pagination justify-content-center" id="pagination"></ul>
        </nav>
      </div>
    </div>
  </div>

  <script>
  let currentPage = 1;

  document.addEventListener('DOMContentLoaded', () => loadDoctors());

  async function loadDoctors(page = 1) {
    currentPage = page;
    const search = document.getElementById('searchInput').value;
    const isApproved = document.getElementById('statusFilter').value;

    // Gọi API lấy JSON
    let url = `/admin/doctors/list?page=${page}&limit=10&search=${search}`;
    if(isApproved) url += `&is_approved=${isApproved}`;

    try {
      const res = await fetch(url);
      const data = await res.json();

      if(data.success) {
        renderTable(data.data);
        renderPagination(data.metadata); // Dùng lại hàm phân trang cũ
      }
    } catch (err) {
      console.error(err);
    }
  }

  function renderTable(doctors) {
    const tbody = document.getElementById('doctorsTableBody');
    if(!doctors.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Không tìm thấy bác sĩ nào</td></tr>';
        return;
    }

    tbody.innerHTML = doctors.map(doc => `
      <tr>
        <td>
            <div class="d-flex align-items-center">
                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="fas fa-user-md text-primary"></i>
                </div>
                <div>
                    <div class="fw-bold">${doc.user?.full_name || 'Không tên'}</div>
                    <div class="small text-muted">${doc.user?.email}</div>
                </div>
            </div>
        </td>
        <td>
            <span class="badge bg-info text-dark">
                ${doc.specialty?.name || 'Chưa cập nhật'}
            </span>
        </td>
        <td>
          ${doc.is_approved
            ? '<span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã duyệt</span>'
            : '<span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Chờ duyệt</span>'}
        </td>
        <td>
            ${doc.user?.is_active
                ? '<span class="text-success"><i class="fas fa-circle me-1" style="font-size: 8px;"></i>Online</span>'
                : '<span class="text-danger"><i class="fas fa-circle me-1" style="font-size: 8px;"></i>Đã khóa</span>'}
        </td>
        <td>
           <div class="btn-group">
               ${!doc.is_approved ? `
                   <button class="btn btn-sm btn-outline-success" onclick="updateStatus(${doc.id}, true)" title="Duyệt hồ sơ">
                     <i class="fas fa-check"></i> Duyệt
                   </button>
               ` : `
                   <button class="btn btn-sm btn-outline-secondary" onclick="updateStatus(${doc.id}, false)" title="Hủy duyệt">
                     <i class="fas fa-ban"></i> Hủy
                   </button>
               `}
               <a href="/doctors/${doc.id}" target="_blank" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                    <i class="fas fa-eye"></i>
               </a>
           </div>
        </td>
      </tr>
    `).join('');
  }

  async function updateStatus(doctorId, status) {
      if(!confirm(status ? 'Duyệt bác sĩ này hoạt động?' : 'Hủy quyền hoạt động của bác sĩ này?')) return;

      try {
          const res = await fetch(`/admin/doctors/${doctorId}/approve`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ is_approved: status })
          });
          const data = await res.json();

          if(data.success) {
              alert('Cập nhật thành công!');
              loadDoctors(currentPage);
          } else {
              alert('Lỗi: ' + data.message);
          }
      } catch (err) {
          alert('Lỗi kết nối');
      }
  }

  // Hàm phân trang (Copy lại từ Users sang để dùng chung)
  function renderPagination(metadata) {
      const pagination = document.getElementById('pagination');
      let html = '';
      for(let i=1; i<=metadata.total_pages; i++) {
          html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                      <button class="page-link" onclick="loadDoctors(${i})">${i}</button>
                   </li>`;
      }
      pagination.innerHTML = html;
  }
  </script>