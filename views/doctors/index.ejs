<div class="bg-light py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary">Đội Ngũ Bác Sĩ</h1>
            <p class="text-muted lead">Các chuyên gia y tế hàng đầu sẵn sàng tư vấn cho bạn</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold"><i class="fas fa-filter me-2 text-primary"></i>Chuyên khoa</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        <a href="/doctors" class="list-group-item list-group-item-action <%= !currentSpecialty ? 'active' : '' %>">
                            Tất cả chuyên khoa
                        </a>
                        <% if (typeof specialties !== 'undefined') { %>
                            <% specialties.forEach(spec => { %>
                                <a href="/doctors?specialty=<%= spec.slug %>"
                                   class="list-group-item list-group-item-action <%= currentSpecialty === spec.slug ? 'active' : '' %>">
                                    <%= spec.name %>
                                </a>
                            <% }) %>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="row g-4">
                    <% if (doctors && doctors.length > 0) { %>
                        <% doctors.forEach(doctor => { %>
                            <div class="col-md-6 col-xl-4">
                                <div class="card h-100 border-0 shadow-sm hover-shadow text-center">
                                    <div class="position-relative pt-4">
                                        <img src="<%= (doctor.user && doctor.user.avatar) ? doctor.user.avatar : 'https://placehold.co/400x400/e9ecef/6c757d?text=Doctor' %>"
                                             class="rounded-circle img-thumbnail shadow-sm"
                                             style="width: 140px; height: 140px; object-fit: cover;"
                                             alt="<%= doctor.user.full_name %>">
                                        <span class="position-absolute top-0 end-0 m-3 badge bg-success rounded-pill">
                                            <i class="fas fa-check-circle me-1"></i>Uy tín
                                        </span>
                                    </div>

                                    <div class="card-body">
                                        <h5 class="fw-bold mb-1"><%= doctor.user.full_name %></h5>
                                        <p class="text-primary small fw-bold mb-3">
                                            <%= doctor.specialty ? doctor.specialty.name : 'Đa khoa' %>
                                        </p>

                                        <div class="d-flex justify-content-center gap-2 mb-3">
                                            <span class="badge bg-light text-dark border">
                                                <i class="fas fa-briefcase me-1"></i>5+ Năm KN
                                            </span>
                                            <span class="badge bg-light text-dark border">
                                                <i class="fas fa-star text-warning me-1"></i>5.0
                                            </span>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <a href="/doctors/<%= doctor.id %>" class="btn btn-outline-primary btn-sm rounded-pill">
                                                Xem hồ sơ
                                            </a>
                                            <a href="/appointments/booking" class="btn btn-primary btn-sm rounded-pill">
                                                Đặt lịch ngay
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-12 text-center py-5">
                            <p class="text-muted">Chưa tìm thấy bác sĩ nào phù hợp.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>