
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card bg-primary text-white h-100 stat-card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Tổng Bác sĩ</h6>
                        <h2 class="display-6 fw-bold mb-0"><%= totalDoctors %></h2>
                    </div>
                    <i class="fas fa-user-md fa-3x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between small border-0 bg-primary bg-opacity-10">
                <a class="text-white text-decoration-none stretched-link" href="/admin/doctors">Xem chi tiết</a>
                <div class="text-white"><i class="fas fa-angle-right"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card bg-success text-white h-100 stat-card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Bệnh nhân</h6>
                        <h2 class="display-6 fw-bold mb-0"><%= totalPatients %></h2>
                    </div>
                    <i class="fas fa-procedures fa-3x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between small border-0 bg-success bg-opacity-10">
                <a class="text-white text-decoration-none stretched-link" href="/admin/users">Xem chi tiết</a>
                <div class="text-white"><i class="fas fa-angle-right"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card bg-warning text-dark h-100 stat-card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Lịch hẹn</h6>
                        <h2 class="display-6 fw-bold mb-0"><%= totalAppointments %></h2>
                    </div>
                    <i class="fas fa-calendar-check fa-3x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between small border-0 bg-warning bg-opacity-10">
                <a class="text-dark text-decoration-none stretched-link" href="/admin/appointments">Quản lý lịch</a>
                <div class="text-dark"><i class="fas fa-angle-right"></i></div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card bg-danger text-white h-100 stat-card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Bài viết</h6>
                        <h2 class="display-6 fw-bold mb-0"><%= totalPosts %></h2>
                    </div>
                    <i class="fas fa-newspaper fa-3x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer d-flex align-items-center justify-content-between small border-0 bg-danger bg-opacity-10">
                <a class="text-white text-decoration-none stretched-link" href="/admin/posts">Quản lý bài viết</a>
                <div class="text-white"><i class="fas fa-angle-right"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 text-primary fw-bold"><i class="fas fa-chart-line me-2"></i>Hoạt động gần đây</h5>
            </div>
            <div class="card-body text-center py-5">
                <p class="text-muted">Chưa có dữ liệu hoạt động gần đây</p>
            </div>
        </div>
    </div>
</div>