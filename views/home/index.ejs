<!-- Hero Slider -->
<section class="hero-slider">
  <div class="swiper heroSwiper">
    <div class="swiper-wrapper">
      <!-- Slide 1 -->
      <div class="swiper-slide">
        <div class="position-relative">
          <img src="https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?w=1920&h=400&fit=crop" 
               alt="Medical Team" class="w-100" style="height: 400px; object-fit: cover;">
          <div class="position-absolute top-0 start-0 w-100 h-100" 
               style="background: linear-gradient(135deg, rgba(0,102,204,0.85) 0%, rgba(0,166,160,0.75) 100%);">
            <div class="container h-100 d-flex align-items-center">
              <div class="row">
                <div class="col-lg-7">
                  <h1 class="display-4 fw-bold text-white mb-3">Chăm sóc sức khỏe toàn diện</h1>
                  <p class="fs-5 text-white mb-4">Đội ngũ bác sĩ chuyên môn cao, trang thiết bị hiện đại</p>
                  <div>
                    <a href="/appointments/book" class="btn btn-light btn-lg me-2">
                      <i class="fas fa-calendar-check me-2"></i>Đặt lịch khám
                    </a>
                    <a href="/doctors" class="btn btn-outline-light btn-lg">
                      <i class="fas fa-user-md me-2"></i>Đội ngũ bác sĩ
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Slide 2 -->
      <div class="swiper-slide">
        <div class="position-relative">
          <img src="https://images.unsplash.com/photo-1551076805-e1869033e561?w=1920&h=400&fit=crop" 
               alt="Modern Hospital" class="w-100" style="height: 400px; object-fit: cover;">
          <div class="position-absolute top-0 start-0 w-100 h-100" 
               style="background: linear-gradient(135deg, rgba(0,166,160,0.85) 0%, rgba(40,167,69,0.75) 100%);">
            <div class="container h-100 d-flex align-items-center">
              <div class="row">
                <div class="col-lg-7">
                  <h1 class="display-4 fw-bold text-white mb-3">Cơ sở vật chất hiện đại</h1>
                  <p class="fs-5 text-white mb-4">Trang thiết bị y tế tiên tiến, phòng khám đạt chuẩn quốc tế</p>
                  <div>
                    <a href="/specialties" class="btn btn-light btn-lg me-2">
                      <i class="fas fa-hospital me-2"></i>Chuyên khoa
                    </a>
                    <a href="/posts" class="btn btn-outline-light btn-lg">
                      <i class="fas fa-newspaper me-2"></i>Tin tức Y tế
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Slide 3 -->
      <div class="swiper-slide">
        <div class="position-relative">
          <img src="https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=1920&h=400&fit=crop" 
               alt="Online Consultation" class="w-100" style="height: 400px; object-fit: cover;">
          <div class="position-absolute top-0 start-0 w-100 h-100" 
               style="background: linear-gradient(135deg, rgba(0,102,204,0.85) 0%, rgba(138,43,226,0.75) 100%);">
            <div class="container h-100 d-flex align-items-center">
              <div class="row">
                <div class="col-lg-7">
                  <h1 class="display-4 fw-bold text-white mb-3">Tư vấn trực tuyến 24/7</h1>
                  <p class="fs-5 text-white mb-4">Kết nối với bác sĩ mọi lúc mọi nơi, tiện lợi và bảo mật</p>
                  <div>
                    <a href="/chat" class="btn btn-light btn-lg me-2">
                      <i class="fas fa-comments me-2"></i>Tư vấn ngay
                    </a>
                    <a href="/contact" class="btn btn-outline-light btn-lg">
                      <i class="fas fa-phone-alt me-2"></i>Liên hệ
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div>
  </div>
</section>

<!-- Quick Stats -->
<section class="quick-stats py-5 bg-light">
  <div class="container">
    <div class="row text-center">
      <div class="col-md-3 col-6 mb-4 mb-md-0">
        <div class="stat-item">
          <i class="fas fa-user-md fa-3x text-primary mb-3"></i>
          <h2 class="fw-bold mb-0">
            <span class="counter" data-target="<%= (doctors && doctors.length) || 150 %>">0</span>+
          </h2>
          <p class="text-muted mb-0">Bác sĩ giỏi</p>
        </div>
      </div>
      <div class="col-md-3 col-6 mb-4 mb-md-0">
        <div class="stat-item">
          <i class="fas fa-hospital fa-3x text-success mb-3"></i>
          <h2 class="fw-bold mb-0">
            <span class="counter" data-target="<%= (specialties && specialties.length) || 25 %>">0</span>+
          </h2>
          <p class="text-muted mb-0">Chuyên khoa</p>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="stat-item">
          <i class="fas fa-users fa-3x text-info mb-3"></i>
          <h2 class="fw-bold mb-0">
            <span class="counter" data-target="50000">0</span>+
          </h2>
          <p class="text-muted mb-0">Bệnh nhân</p>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="stat-item">
          <i class="fas fa-award fa-3x text-warning mb-3"></i>
          <h2 class="fw-bold mb-0">
            <span class="counter" data-target="20">0</span>+
          </h2>
          <p class="text-muted mb-0">Năm kinh nghiệm</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Specialties Section -->
<section class="specialties-section py-5">
  <div class="container">
    <div class="section-title text-center mb-5">
      <h2 class="display-5 fw-bold">Chuyên khoa của chúng tôi</h2>
      <p class="text-muted">Đa dạng các chuyên khoa với đội ngũ bác sĩ chuyên môn cao</p>
    </div>
    
    <div class="row g-4">
      <% (specialties || []).slice(0, 6).forEach(specialty => { %>
        <div class="col-lg-4 col-md-6">
          <div class="card specialty-card h-100 shadow-sm border-0">
            <div class="card-body text-center p-4">
              <div class="specialty-icon mb-3">
                <i class="<%= specialty.icon || 'fas fa-stethoscope' %> fa-3x text-primary"></i>
              </div>
              <h5 class="card-title fw-bold mb-3"><%= specialty.name %></h5>
              <p class="card-text text-muted"><%= specialty.description %></p>
              <a href="/specialties/<%= specialty.slug %>" class="btn btn-outline-primary btn-sm mt-2">
                Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    
    <div class="text-center mt-5">
      <a href="/specialties" class="btn btn-primary btn-lg">
        Xem tất cả chuyên khoa <i class="fas fa-chevron-right ms-2"></i>
      </a>
    </div>
  </div>
</section>

<!-- Featured Doctors -->
<section class="featured-doctors py-5 bg-light">
  <div class="container">
    <div class="section-title text-center mb-5">
      <h2 class="display-5 fw-bold">Đội ngũ bác sĩ nổi bật</h2>
      <p class="text-muted">Bác sĩ chuyên môn cao, tận tâm với nghề</p>
    </div>
    
    <div class="swiper doctorsSwiper">
      <div class="swiper-wrapper">
        <% if (doctors && doctors.length > 0) { %>
          <% doctors.forEach(doctor => { %>
            <% if (doctor && doctor.user && doctor.specialty) { %>
            <div class="swiper-slide">
              <div class="card doctor-card h-100 border-0 shadow-sm">
                <div class="doctor-image-wrapper">
                  <img src="<%= doctor.user.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(doctor.user.full_name) + '&size=400&background=0066CC&color=fff' %>" 
                       class="card-img-top" alt="<%= doctor.user.full_name %>"
                       onerror="this.src='https://placehold.co/400x300/0066CC/FFFFFF/png?text=Doctor'">
                  <div class="doctor-rating">
                    <i class="fas fa-star text-warning"></i>
                    <span class="text-dark"><%= doctor.rating || '5.0' %></span>
                  </div>
                </div>
                <div class="card-body">
                  <h5 class="card-title fw-bold mb-2"><%= doctor.user.full_name %></h5>
                  <p class="text-primary mb-2">
                    <i class="fas fa-user-md me-1"></i><%= doctor.specialty.name %>
                  </p>
                  <p class="text-muted small mb-3">
                    <i class="fas fa-briefcase me-1"></i><%= doctor.experience_years %> năm kinh nghiệm
                  </p>
                  <div class="d-grid gap-2">
                    <a href="/doctors/<%= doctor.user_id %>" class="btn btn-outline-primary btn-sm">
                      <i class="fas fa-user me-1"></i>Xem hồ sơ
                    </a>
                    <a href="/appointments/book?doctor=<%= doctor.user_id %>" class="btn btn-primary btn-sm">
                      <i class="fas fa-calendar-check me-1"></i>Đặt lịch khám
                    </a>
                  </div>
                </div>
              </div>
            </div>
            <% } %>
          <% }); %>
        <% } else { %>
          <div class="swiper-slide">
            <div class="text-center py-5">
              <p class="text-muted">Chưa có bác sĩ nào</p>
            </div>
          </div>
        <% } %>
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

<!-- Latest Posts -->
<section class="latest-posts py-5">
  <div class="container">
    <div class="section-title text-center mb-5">
      <h2 class="display-5 fw-bold">Tin tức Y tế mới nhất</h2>
      <p class="text-muted">Cập nhật kiến thức sức khỏe và tin tức y tế</p>
    </div>
    
    <div class="row g-4">
      <% if (posts && posts.length > 0) { %>
        <% posts.slice(0, 3).forEach(post => { %>
          <div class="col-lg-4 col-md-6">
            <div class="card post-card h-100 border-0 shadow-sm">
              <div class="post-thumbnail">
                <img src="<%= post.thumbnail || 'https://source.unsplash.com/600x400/?medical,health,hospital' %>" 
                     class="card-img-top" alt="<%= post.title %>" onerror="this.src='https://placehold.co/600x400/0066CC/FFFFFF/png?text=News'">
                <% if (post.category) { %>
                <span class="post-badge bg-primary text-white">
                  <%= post.category.replace('_', ' ').toUpperCase() %>
                </span>
                <% } %>
              </div>
              <div class="card-body">
                <div class="post-meta text-muted mb-2">
                  <small>
                    <i class="fas fa-calendar me-1"></i>
                    <%= new Date(post.published_at || post.created_at).toLocaleDateString('vi-VN') %>
                  </small>
                  <small class="ms-3">
                    <i class="fas fa-eye me-1"></i><%= post.views || 0 %> lượt xem
                  </small>
                </div>
                <h5 class="card-title fw-bold mb-3">
                  <a href="/posts/<%= post.slug %>" class="text-decoration-none text-dark hover-primary">
                    <%= post.title %>
                  </a>
                </h5>
                <p class="card-text text-muted"><%= post.summary || (post.content ? post.content.substring(0, 150) + '...' : 'Nội dung bài viết...') %></p>
                <a href="/posts/<%= post.slug %>" class="btn btn-link text-primary p-0 text-decoration-none">
                  Đọc thêm <i class="fas fa-arrow-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12">
          <div class="text-center py-5">
            <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
            <p class="text-muted">Chưa có bài viết nào được đăng</p>
          </div>
        </div>
      <% } %>
    </div>
    
    <div class="text-center mt-5">
      <a href="/posts" class="btn btn-primary btn-lg">
        Xem tất cả tin tức <i class="fas fa-chevron-right ms-2"></i>
      </a>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="cta-section py-5 text-white">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-8 text-center text-lg-start mb-4 mb-lg-0">
        <h2 class="display-6 fw-bold mb-3">Đặt lịch khám ngay hôm nay!</h2>
        <p class="lead mb-0">Chăm sóc sức khỏe của bạn là ưu tiên hàng đầu của chúng tôi</p>
      </div>
      <div class="col-lg-4 text-center text-lg-end">
        <a href="/appointments/book" class="btn btn-light btn-lg px-5">
          <i class="fas fa-calendar-check me-2"></i>Đặt lịch ngay
        </a>
      </div>
    </div>
  </div>
</section>
