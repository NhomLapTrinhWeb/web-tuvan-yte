<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Portal - <%= typeof pageTitle !== 'undefined' ? pageTitle : '' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css"> </head>
<body>
    <div class="d-flex" id="wrapper">
        <div class="bg-info text-white" id="sidebar-wrapper" style="min-width: 250px; min-height: 100vh;">
            <div class="sidebar-heading text-center py-4 fs-4 fw-bold border-bottom border-light">
                <i class="fas fa-user-md me-2"></i>Doctor Panel
            </div>
            <div class="list-group list-group-flush my-3">
                <a href="/doctor/dashboard" class="list-group-item list-group-item-action bg-transparent text-white border-0">
                    <i class="fas fa-tachometer-alt me-2"></i>Tổng quan
                </a>
                <a href="/doctor/appointments" class="list-group-item list-group-item-action bg-transparent text-white border-0">
                    <i class="fas fa-calendar-check me-2"></i>Lịch khám
                </a>
                <a href="/doctor/patients" class="list-group-item list-group-item-action bg-transparent text-white border-0">
                    <i class="fas fa-users me-2"></i>Bệnh nhân
                </a>
                <a href="/chat" class="list-group-item list-group-item-action bg-transparent text-white border-0">
                    <i class="fas fa-comments me-2"></i>Tư vấn
                </a>
                <a href="/" class="list-group-item list-group-item-action bg-transparent text-white border-0 mt-3 border-top border-light pt-3">
                    <i class="fas fa-home me-2"></i>Về trang chủ
                </a>
            </div>
        </div>

        <div id="page-content-wrapper" class="w-100 bg-light">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 py-3 shadow-sm">
                <h4 class="m-0 text-info"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h4>
                <div class="ms-auto">
                    <span class="fw-bold text-muted me-2"><%= user ? user.full_name : '' %></span>
                    <a href="/logout" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
                </div>
            </nav>
            <div class="container-fluid px-4 py-4">
                <%- body %>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>