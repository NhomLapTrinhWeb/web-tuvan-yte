  <div class="stats-grid">
    <div class="stat-card">
      <h3>Người dùng</h3>
      <p class="stat-number"><%= totalUsers %></p>
    </div>
    
    <div class="stat-card">
      <h3>Bác sĩ</h3>
      <p class="stat-number"><%= totalDoctors %></p>
    </div>
    
    <div class="stat-card">
      <h3>Lịch hẹn</h3>
      <p class="stat-number"><%= totalAppointments %></p>
    </div>
    
    <div class="stat-card">
      <h3>Bài viết</h3>
      <p class="stat-number"><%= totalPosts %></p>
    </div>
  </div>
</div>
