<div class="container my-5">
  <div class="row mb-4">
    <div class="col-12">
      <h2 class="mb-3">Chọn Bác Sĩ</h2>
      <p class="text-muted">Bước 1/3: Chọn bác sĩ phù hợp với nhu cầu của bạn</p>
    </div>
  </div>

  <!-- Filter Section -->
  <div class="row mb-4">
    <div class="col-md-4">
      <select class="form-select" id="specialtyFilter">
        <option value="">Tất cả chuyên khoa</option>
        <% specialties.forEach(specialty => { %>
          <option value="<%= specialty.id %>" <%= selectedSpecialty == specialty.id ? 'selected' : '' %>>
            <%= specialty.name %>
          </option>
        <% }) %>
      </select>
    </div>
  </div>

  <!-- Doctors Grid -->
  <% if (doctors && doctors.length > 0) { %>
    <div class="row g-4">
      <% doctors.forEach(doctor => { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm hover-card">
            <div class="card-body">
              <div class="d-flex align-items-center mb-3">
                <img src="<%= doctor.user.avatar || 'https://placehold.co/80x80/0066CC/FFFFFF/png?text=Dr' %>" 
                     alt="<%= doctor.user.full_name %>"
                     class="rounded-circle me-3"
                     style="width: 80px; height: 80px; object-fit: cover;">
                <div>
                  <h5 class="mb-1"><%= doctor.user.full_name %></h5>
                  <% if (doctor.specialty) { %>
                    <p class="text-muted mb-0"><%= doctor.specialty.name %></p>
                  <% } %>
                  <div class="text-warning">
                    <i class="fas fa-star"></i>
                    <%= (Number(doctor.rating) || 0).toFixed(1) %>
                  </div>
                </div>
              </div>

              <div class="mb-3">
                <small class="text-muted">
                  <i class="fas fa-briefcase me-1"></i>
                  <%= doctor.experience_years %> năm kinh nghiệm
                </small>
              </div>

              <% if (doctor.bio) { %>
                <p class="text-muted small mb-3" style="max-height: 60px; overflow: hidden;">
                  <%= doctor.bio.substring(0, 100) %><%= doctor.bio.length > 100 ? '...' : '' %>
                </p>
              <% } %>

              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <strong class="text-primary">
                    <%= doctor.consultation_price ? doctor.consultation_price.toLocaleString('vi-VN') + 'đ' : 'Liên hệ' %>
                  </strong>
                  <br>
                  <small class="text-muted">Phí khám</small>
                </div>
              </div>

              <a href="/appointments/book/<%= doctor.id %>" class="btn btn-primary w-100">
                <i class="fas fa-calendar-check me-2"></i>Đặt lịch ngay
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <i class="fas fa-user-md fa-4x text-muted mb-3"></i>
      <p class="text-muted">Không tìm thấy bác sĩ phù hợp</p>
    </div>
  <% } %>
</div>

<style>
  .hover-card {
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .hover-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
  }
</style>

<script>
  // Specialty filter
  document.getElementById('specialtyFilter')?.addEventListener('change', (e) => {
    const specialtyId = e.target.value;
    const url = new URL(window.location.href);
    if (specialtyId) {
      url.searchParams.set('specialty_id', specialtyId);
    } else {
      url.searchParams.delete('specialty_id');
    }
    window.location.href = url.toString();
  });
</script>
