<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= typeof seoDescription !== 'undefined' ? seoDescription : 'Bệnh viện Đa khoa' %>">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - ' : '' %>Hospital Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('../partials/header') %>

    <div class="container mt-3">
        <%- include('../partials/flash-messages') %>
    </div>

    <main>
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const logoutBtn = document.getElementById('logoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', async (e) => {
                    e.preventDefault();
                    if(!confirm('Bạn có chắc muốn đăng xuất?')) return;

                    try {
                        // Gọi API đăng xuất
                        // Vì chúng ta dùng session/token hỗn hợp, cách đơn giản nhất là xóa cookie và reload
                        document.cookie = 'access_token=; Max-Age=0; path=/;';
                        window.location.href = '/login?message=logout_success';
                    } catch (error) {
                        console.error('Logout error:', error);
                        alert('Có lỗi xảy ra khi đăng xuất');
                    }
                });
            }
        });
    </script>
</body>
</html>