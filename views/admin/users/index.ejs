<div class="container-fluid py-4">
    <h2 class="mb-4">Quản Lý Người Dùng</h2>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4">
            <input type="text" class="form-control" id="searchInput" placeholder="Tìm tên, email hoặc SĐT...">
          </div>
          <div class="col-md-3">
            <select class="form-select" id="roleFilter">
              <option value="">Tất cả vai trò</option>
              <option value="patient">Bệnh nhân</option>
              <option value="doctor">Bác sĩ</option>
              <option value="admin">Quản trị viên</option>
            </select>
          </div>
          <div class="col-md-2">
            <button class="btn btn-primary w-100" onclick="loadUsers()">
              <i class="fas fa-search me-2"></i>Tìm kiếm
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Họ và Tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody id="usersTableBody">
              <tr><td colspan="7" class="text-center py-3"><div class="spinner-border text-primary"></div></td></tr>
            </tbody>
          </table>
        </div>

        <nav class="mt-3">
            <ul class="pagination justify-content-center" id="pagination"></ul>
        </nav>
      </div>
    </div>
  </div>

  <script>
  let currentPage = 1;

  document.addEventListener('DOMContentLoaded', () => loadUsers());

  async function loadUsers(page = 1) {
    currentPage = page;
    const search = document.getElementById('searchInput').value;
    const role = document.getElementById('roleFilter').value;

    // Gọi API lấy dữ liệu JSON (Chú ý đường dẫn /list)
    const url = `/admin/users/list?page=${page}&limit=10&search=${search}&role=${role}`;

    try {
      const res = await fetch(url);
      const data = await res.json();

      if(data.success) {
        renderTable(data.data);
        renderPagination(data.metadata);
      } else {
        alert('Lỗi tải dữ liệu');
      }
    } catch (err) {
      console.error(err);
      document.getElementById('usersTableBody').innerHTML = '<tr><td colspan="7" class="text-center text-danger">Lỗi kết nối API</td></tr>';
    }
  }

  function renderTable(users) {
    const tbody = document.getElementById('usersTableBody');
    if(!users.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Không tìm thấy người dùng nào</td></tr>';
        return;
    }

    const roleBadges = {
        admin: '<span class="badge bg-danger">Admin</span>',
        doctor: '<span class="badge bg-info">Bác sĩ</span>',
        patient: '<span class="badge bg-success">Bệnh nhân</span>'
    };

    tbody.innerHTML = users.map(user => `
      <tr>
        <td>#${user.id}</td>
        <td class="fw-bold">${user.full_name || 'N/A'}</td>
        <td>${user.email}</td>
        <td>${user.phone || '-'}</td>
        <td>${roleBadges[user.role] || user.role}</td>
        <td>
          ${user.is_active
            ? '<span class="badge bg-success">Hoạt động</span>'
            : '<span class="badge bg-secondary">Đã khóa</span>'}
        </td>
        <td>
           ${user.role === 'patient' ? `
             <button class="btn btn-sm btn-outline-primary me-1" 
                     onclick="promoteToDoctor(${user.id}, '${user.full_name}')"
                     title="Cấp quyền Bác sĩ">
               <i class="fas fa-user-md"></i>
             </button>
           ` : ''}
           ${user.role === 'doctor' ? `
             <button class="btn btn-sm btn-outline-warning me-1" 
                     onclick="demoteToPatient(${user.id}, '${user.full_name}')"
                     title="Hủy quyền Bác sĩ">
               <i class="fas fa-user"></i>
             </button>
           ` : ''}
           <button class="btn btn-sm ${user.is_active ? 'btn-outline-danger' : 'btn-outline-success'}"
                   onclick="toggleStatus(${user.id})"
                   title="${user.is_active ? 'Khóa tài khoản' : 'Mở khóa'}">
             <i class="fas ${user.is_active ? 'fa-lock' : 'fa-unlock'}"></i>
           </button>
        </td>
      </tr>
    `).join('');
  }

  async function toggleStatus(userId) {
      if(!confirm('Bạn có chắc muốn thay đổi trạng thái tài khoản này?')) return;

      try {
          const res = await fetch(`/admin/users/${userId}/toggle-status`, { method: 'POST' });
          const data = await res.json();
          if(data.success) {
              alert(data.message);
              loadUsers(currentPage); // Tải lại bảng
          } else {
              alert('Lỗi: ' + data.message);
          }
      } catch (err) {
          alert('Có lỗi xảy ra');
      }
  }

  // Cấp quyền Bác sĩ
  async function promoteToDoctor(userId, userName) {
      if(!confirm(`Bạn có chắc muốn cấp quyền BÁC SĨ cho "${userName}"?\n\nSau khi cấp quyền, người dùng này sẽ có thể:\n- Xem lịch hẹn khám\n- Tư vấn bệnh nhân\n- Quản lý bệnh nhân`)) return;

      try {
          const res = await fetch(`/admin/users/${userId}/change-role`, { 
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ role: 'doctor' })
          });
          const data = await res.json();
          if(data.success) {
              alert('✅ ' + data.message);
              loadUsers(currentPage);
          } else {
              alert('❌ Lỗi: ' + data.message);
          }
      } catch (err) {
          alert('Có lỗi xảy ra');
      }
  }

  // Hủy quyền Bác sĩ
  async function demoteToPatient(userId, userName) {
      if(!confirm(`Bạn có chắc muốn HỦY quyền Bác sĩ của "${userName}"?\n\nNgười dùng này sẽ trở thành Bệnh nhân thường.`)) return;

      try {
          const res = await fetch(`/admin/users/${userId}/change-role`, { 
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ role: 'patient' })
          });
          const data = await res.json();
          if(data.success) {
              alert('✅ ' + data.message);
              loadUsers(currentPage);
          } else {
              alert('❌ Lỗi: ' + data.message);
          }
      } catch (err) {
          alert('Có lỗi xảy ra');
      }
  }

  function renderPagination(metadata) {
      // (Bạn có thể copy hàm renderPagination từ file posts/index.ejs sang đây để dùng chung logic)
      const pagination = document.getElementById('pagination');
      let html = '';
      for(let i=1; i<=metadata.total_pages; i++) {
          html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                      <button class="page-link" onclick="loadUsers(${i})">${i}</button>
                   </li>`;
      }
      pagination.innerHTML = html;
  }
  </script>