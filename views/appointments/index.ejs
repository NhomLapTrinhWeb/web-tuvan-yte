<div class="bg-light py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-white p-4 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0 fw-bold text-primary"><i class="fas fa-notes-medical me-2"></i>Lịch Sử Khám Bệnh</h4>
                            <a href="/appointments/booking" class="btn btn-primary btn-sm rounded-pill px-3">
                                <i class="fas fa-plus me-1"></i> Đặt lịch mới
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <% if (appointments && appointments.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light text-muted small text-uppercase">
                                        <tr>
                                            <th class="ps-4">Bác sĩ</th>
                                            <th>Thời gian</th>
                                            <th>Trạng thái</th>
                                            <th>Ghi chú</th>
                                            <th class="text-end pe-4">Thao tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% appointments.forEach(app => { %>
                                            <tr>
                                                <td class="ps-4">
                                                    <div class="d-flex align-items-center">
                                                        <img src="<%= (app.Doctor && app.Doctor.user && app.Doctor.user.avatar) ? app.Doctor.user.avatar : 'https://placehold.co/100x100?text=BS' %>"
                                                             class="rounded-circle me-3" width="45" height="45">
                                                        <div>
                                                            <div class="fw-bold"><%= app.Doctor && app.Doctor.user ? app.Doctor.user.full_name : 'Bác sĩ' %></div>
                                                            <small class="text-muted"><%= app.Doctor && app.Doctor.specialty ? app.Doctor.specialty.name : 'Đa khoa' %></small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark"><%= new Date(app.appointment_date).toLocaleDateString('vi-VN') %></div>
                                                    <div class="small text-primary"><i class="far fa-clock me-1"></i><%= app.time_slot %></div>
                                                </td>
                                                <td>
                                                    <% if(app.status == 'pending') { %>
                                                        <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                                    <% } else if(app.status == 'confirmed') { %>
                                                        <span class="badge bg-primary">Đã xác nhận</span>
                                                    <% } else if(app.status == 'completed') { %>
                                                        <span class="badge bg-success">Đã khám</span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger">Đã hủy</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <span class="text-muted small fst-italic"><%= app.reason || 'Không có ghi chú' %></span>
                                                </td>
                                                <td class="text-end pe-4">
                                                    <% if(app.status == 'completed') { %>
                                                        <a href="/medical-records/view/<%= app.id %>" class="btn btn-primary btn-sm rounded-pill">
                                                            <i class="fas fa-file-medical me-1"></i> Xem kết quả
                                                        </a>
                                                    <% } else { %>
                                                        <button class="btn btn-sm btn-light" disabled>...</button>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="text-center py-5">
                                <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800926.png" width="200" alt="Empty">
                                <h5 class="text-muted mt-3">Bạn chưa có lịch khám nào</h5>
                                <a href="/appointments/booking" class="btn btn-outline-primary mt-2">Đặt lịch khám ngay</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>