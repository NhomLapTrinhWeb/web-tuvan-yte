{
  "name": "hospital-booking-system",
  "version": "1.0.0",
  "description": "Hệ thống đặt lịch khám bệnh trực tuyến",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node database/initDatabase.js",
    "db:drop": "node database/resetDatabase.js",
    "db:create": "node database/createDatabase.js",
    "db:seed:specialties": "node database/seedSpecialties.js",
    "db:seed:all": "node database/seedAll.js",
    "db:setup": "npm run db:init && npm run db:create && npm run db:seed:specialties && npm run db:seed:all",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:seed:specialties && npm run db:seed:all",
    "seed": "node seeders/seed.js"
  },
  "keywords": [
    "hospital",
    "booking",
    "healthcare",
    "appointment"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.13.0",
    "qs": "^6.14.0",
    "sequelize": "^6.35.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
