<div class="bg-light py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary">Tin Tức Y Tế & Sức Khỏe</h1>
            <p class="text-muted lead">Cập nhật những thông tin y khoa mới nhất từ đội ngũ chuyên gia</p>
        </div>

        <div class="row g-4">
            <% if (posts && posts.length > 0) { %>
                <% posts.forEach(post => { %>
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm hover-shadow transition-hover">
                            <a href="/posts/<%= post.slug %>" class="overflow-hidden">
                                <img src="<%= post.thumbnail || 'https://img.freepik.com/free-photo/medical-banner-with-stethoscope_23-2149611199.jpg' %>"
                                     class="card-img-top"
                                     alt="<%= post.title %>"
                                     style="height: 220px; object-fit: cover; transition: transform 0.3s ease;">
                            </a>

                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2 small">
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                                        <%= post.category ? post.category.toUpperCase() : 'Y TẾ' %>
                                    </span>
                                    <span class="text-muted">
                                        <i class="far fa-clock me-1"></i>
                                        <%= post.published_at ? new Date(post.published_at).toLocaleDateString('vi-VN') : (post.createdAt ? new Date(post.createdAt).toLocaleDateString('vi-VN') : '30/11/2025') %>
                                    </span>
                                </div>

                                <h5 class="card-title fw-bold mt-3 mb-3">
                                    <a href="/posts/<%= post.slug %>" class="text-decoration-none text-dark hover-primary">
                                        <%= post.title %>
                                    </a>
                                </h5>

                                <p class="card-text text-muted small line-clamp-3">
                                    <%= post.summary ? post.summary : 'Bấm để xem chi tiết nội dung bài viết...' %>
                                </p>
                            </div>

                            <div class="card-footer bg-white border-0 p-4 pt-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="small text-muted">
                                        <i class="fas fa-user-edit me-1"></i>
                                        <%= post.author ? post.author.full_name : 'Admin' %>
                                    </div>
                                    <a href="/posts/<%= post.slug %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        Đọc tiếp <i class="fas fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <div class="mb-3 text-muted">
                        <i class="fas fa-newspaper fa-4x opacity-50"></i>
                    </div>
                    <h4>Chưa có bài viết nào</h4>
                    <p class="text-muted">Vui lòng quay lại sau.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<style>
    /* CSS phụ trợ: Hiệu ứng zoom ảnh khi di chuột */
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .card:hover .card-img-top {
        transform: scale(1.05);
    }
    /* Cắt dòng văn bản dài */
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>