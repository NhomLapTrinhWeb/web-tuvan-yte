
<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Chỉnh Sửa Bài Viết</h2>
    <a href="/admin/posts" class="btn btn-secondary">
      <i class="fas fa-arrow-left me-2"></i>Quay lại
    </a>
  </div>

  <form id="editPostForm" enctype="multipart/form-data">
    <input type="hidden" id="postId" value="<%= post.id %>">
    
    <div class="row">
      <!-- Main Content -->
      <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <!-- Title -->
            <div class="mb-3">
              <label for="title" class="form-label">Tiêu đề <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="title" name="title" value="<%= post.title %>" required>
            </div>

            <!-- Slug -->
            <div class="mb-3">
              <label for="slug" class="form-label">Slug (URL)</label>
              <input type="text" class="form-control" id="slug" name="slug" value="<%= post.slug %>">
              <small class="text-muted">Tự động tạo từ tiêu đề nếu để trống</small>
            </div>

            <!-- Summary -->
            <div class="mb-3">
              <label for="summary" class="form-label">Tóm tắt</label>
              <textarea class="form-control" id="summary" name="summary" rows="3"><%= post.summary || '' %></textarea>
            </div>

            <!-- Content (CKEditor) -->
            <div class="mb-3">
              <label for="content" class="form-label">Nội dung <span class="text-danger">*</span></label>
              <textarea id="content" name="content"><%= post.content %></textarea>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4">
        <!-- Publish Settings -->
        <div class="card shadow-sm mb-4">
          <div class="card-header bg-primary text-white">
            <h6 class="mb-0">Xuất bản</h6>
          </div>
          <div class="card-body">
            <!-- Status -->
            <div class="mb-3">
              <label for="status" class="form-label">Trạng thái</label>
              <select class="form-select" id="status" name="status">
                <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>Nháp</option>
                <option value="published" <%= post.status === 'published' ? 'selected' : '' %>>Xuất bản</option>
              </select>
            </div>

            <!-- Category -->
            <div class="mb-3">
              <label for="category" class="form-label">Chuyên mục</label>
              <select class="form-select" id="category" name="category">
                <option value="">-- Chọn chuyên mục --</option>
                <option value="health_tips" <%= post.category === 'health_tips' ? 'selected' : '' %>>Mẹo Sức Khỏe</option>
                <option value="news" <%= post.category === 'news' ? 'selected' : '' %>>Tin Tức</option>
                <option value="disease_info" <%= post.category === 'disease_info' ? 'selected' : '' %>>Thông Tin Bệnh</option>
                <option value="doctor_advice" <%= post.category === 'doctor_advice' ? 'selected' : '' %>>Lời Khuyên Bác Sĩ</option>
                <option value="lifestyle" <%= post.category === 'lifestyle' ? 'selected' : '' %>>Lối Sống</option>
              </select>
            </div>

            <!-- Tags -->
            <div class="mb-3">
              <label for="tags" class="form-label">Tags</label>
              <input type="text" class="form-control" id="tags" name="tags" value="<%= post.tags || '' %>" placeholder="Nhập tags, cách nhau bằng dấu phẩy">
            </div>

            <hr>

            <!-- Actions -->
            <div class="d-grid gap-2">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Cập nhật
              </button>
              <a href="/admin/posts" class="btn btn-outline-secondary">
                <i class="fas fa-times me-2"></i>Hủy
              </a>
            </div>
          </div>
        </div>

        <!-- Featured Image -->
        <div class="card shadow-sm mb-4">
          <div class="card-header">
            <h6 class="mb-0">Ảnh đại diện</h6>
          </div>
          <div class="card-body">
            <% if (post.thumbnail) { %>
              <div id="currentThumbnail" class="text-center mb-3">
                <img src="<%= post.thumbnail %>" class="img-fluid rounded" style="max-height: 200px;">
                <input type="hidden" id="currentThumbnailUrl" value="<%= post.thumbnail %>">
              </div>
            <% } %>
            
            <div class="mb-3">
              <label class="form-label">Thay đổi ảnh</label>
              <input type="file" class="form-control" id="thumbnail" name="thumbnail" accept="image/*">
            </div>
            
            <div id="thumbnailPreview" class="text-center" style="display:none;">
              <img id="thumbnailImg" src="" class="img-fluid rounded" style="max-height: 200px;">
              <button type="button" class="btn btn-sm btn-danger mt-2" onclick="removeThumbnail()">
                <i class="fas fa-trash"></i> Xóa ảnh mới
              </button>
            </div>
          </div>
        </div>

        <!-- SEO Settings -->
        <div class="card shadow-sm">
          <div class="card-header">
            <h6 class="mb-0">SEO</h6>
          </div>
          <div class="card-body">
            <div class="mb-3">
              <label for="meta_title" class="form-label">Meta Title</label>
              <input type="text" class="form-control" id="meta_title" name="meta_title" value="<%= post.meta_title || '' %>">
            </div>
            <div class="mb-3">
              <label for="meta_description" class="form-label">Meta Description</label>
              <textarea class="form-control" id="meta_description" name="meta_description" rows="3"><%= post.meta_description || '' %></textarea>
            </div>
            <div class="mb-3">
              <label for="meta_keywords" class="form-label">Meta Keywords</label>
              <input type="text" class="form-control" id="meta_keywords" name="meta_keywords" value="<%= post.meta_keywords || '' %>">
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>
</div>

<!-- Include CKEditor -->
<script src="/node_modules/@ckeditor/ckeditor5-build-classic/build/ckeditor.js"></script>

<script>
let editor;

// Initialize CKEditor
ClassicEditor
  .create(document.querySelector('#content'), {
    toolbar: [
      'heading', '|',
      'bold', 'italic', 'link', 'bulletedList', 'numberedList', '|',
      'blockQuote', 'insertTable', 'imageUpload', '|',
      'undo', 'redo'
    ],
    ckfinder: {
      uploadUrl: '/admin/upload-image'
    }
  })
  .then(newEditor => {
    editor = newEditor;
  })
  .catch(error => {
    console.error('CKEditor error:', error);
  });

// Auto-generate slug from title (only if slug is empty)
document.getElementById('title').addEventListener('input', function() {
  const slugField = document.getElementById('slug');
  if (!slugField.value) {
    const slug = this.value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/đ/g, 'd')
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    
    slugField.value = slug;
  }
});

// Thumbnail preview
document.getElementById('thumbnail').addEventListener('change', function(e) {
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      document.getElementById('thumbnailImg').src = e.target.result;
      document.getElementById('thumbnailPreview').style.display = 'block';
      if (document.getElementById('currentThumbnail')) {
        document.getElementById('currentThumbnail').style.display = 'none';
      }
    };
    reader.readAsDataURL(file);
  }
});

function removeThumbnail() {
  document.getElementById('thumbnail').value = '';
  document.getElementById('thumbnailPreview').style.display = 'none';
  if (document.getElementById('currentThumbnail')) {
    document.getElementById('currentThumbnail').style.display = 'block';
  }
}

// Submit form
document.getElementById('editPostForm').addEventListener('submit', async function(e) {
  e.preventDefault();

  // Get CKEditor content
  const content = editor.getData();
  if (!content.trim()) {
    alert('Vui lòng nhập nội dung bài viết');
    return;
  }

  const postId = document.getElementById('postId').value;
  const formData = new FormData(this);
  formData.set('content', content);

  try {
    const response = await fetch(`/admin/posts/${postId}`, {
      method: 'PUT',
      body: formData
    });

    const result = await response.json();

    if (result.success) {
      alert('✅ Cập nhật bài viết thành công!');
      window.location.href = '/admin/posts';
    } else {
      alert('❌ Lỗi: ' + (result.message || 'Không thể cập nhật bài viết'));
    }
  } catch (error) {
    console.error('Submit error:', error);
    alert('❌ Có lỗi xảy ra khi cập nhật bài viết');
  }
});
</script>
