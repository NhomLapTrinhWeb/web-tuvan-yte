<%- contentFor('additionalStyles') %>
<style>
  .post-header {
    background: linear-gradient(135deg, rgba(0, 102, 204, 0.9), rgba(0, 76, 153, 0.9)),
                url('<%= post.thumbnail || "https://source.unsplash.com/1920x800/?medical,health" %>') center/cover;
    color: white;
    padding: 5rem 0;
    margin-bottom: 3rem;
  }
  
  .post-content {
    font-size: 1.1rem;
    line-height: 1.8;
  }
  
  .post-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }
  
  .post-content h2, .post-content h3, .post-content h4 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--primary-color);
  }
  
  .post-content ul, .post-content ol {
    margin: 1.5rem 0;
    padding-left: 2rem;
  }
  
  .post-content blockquote {
    border-left: 4px solid var(--primary-color);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #6c757d;
  }
  
  .author-box {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
    margin: 3rem 0;
  }
  
  .related-post-card {
    transition: all 0.3s ease;
  }
  
  .related-post-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(0, 102, 204, 0.15);
  }
  
  .sidebar-widget {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
    margin-bottom: 2rem;
  }
  
  .sidebar-post-item {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid #e9ecef;
  }
  
  .sidebar-post-item:last-child {
    border-bottom: none;
  }
  
  .sidebar-post-thumbnail {
    width: 80px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
  }
</style>
<% -%>

<section class="post-header">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <% if (post.category) { %>
          <span class="badge bg-light text-primary mb-3" style="font-size: 1rem;">
            <% if (post.category.icon) { %>
              <i class="<%= post.category.icon %> me-2"></i>
            <% } %>
            <%= post.category.name %>
          </span>
        <% } %>
        
        <h1 class="display-4 fw-bold mb-4"><%= post.title %></h1>
        
        <div class="d-flex align-items-center gap-4 text-white-50">
          <% if (post.author) { %>
            <div class="d-flex align-items-center">
              <img src="<%= post.author.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(post.author.full_name) + '&size=50' %>" 
                   alt="<%= post.author.full_name %>"
                   class="rounded-circle me-2"
                   style="width: 40px; height: 40px; object-fit: cover;">
              <span><%= post.author.full_name %></span>
            </div>
          <% } %>
          
          <span>
            <i class="fas fa-calendar me-2"></i>
            <%= new Date(post.published_at || post.created_at).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </span>
          
          <span>
            <i class="fas fa-eye me-2"></i>
            <%= (post.views || 0) + 1 %> lượt xem
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="row">
      <div class="col-lg-8">
        <!-- Post Content -->
        <article class="post-content mb-5">
          <%- post.content %>
        </article>
        
        <!-- Author Box -->
        <% if (post.author) { %>
          <div class="author-box">
            <div class="d-flex align-items-center gap-3 mb-3">
              <img src="<%= post.author.avatar || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(post.author.full_name) + '&size=100' %>" 
                   alt="<%= post.author.full_name %>"
                   class="rounded-circle"
                   style="width: 80px; height: 80px; object-fit: cover;">
              <div>
                <h5 class="mb-1">Tác giả: <%= post.author.full_name %></h5>
                <% if (post.author.email) { %>
                  <p class="text-muted mb-0">
                    <i class="fas fa-envelope me-2"></i><%= post.author.email %>
                  </p>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
        
        <!-- Related Posts -->
        <% if (relatedPosts && relatedPosts.length > 0) { %>
          <div class="mt-5">
            <h3 class="mb-4">Bài viết liên quan</h3>
            <div class="row g-4">
              <% relatedPosts.forEach(relatedPost => { %>
                <% if (relatedPost) { %>
                  <div class="col-md-6">
                    <div class="card related-post-card border-0 shadow-sm h-100">
                      <img src="<%= relatedPost.thumbnail || 'https://source.unsplash.com/600x400/?medical,health' %>" 
                           class="card-img-top" 
                           alt="<%= relatedPost.title %>"
                           style="height: 200px; object-fit: cover;"
                           onerror="this.src='https://placehold.co/600x400/0066CC/FFFFFF/png?text=News'">
                      <div class="card-body">
                        <h5 class="card-title">
                          <a href="/posts/<%= relatedPost.slug %>" class="text-decoration-none text-dark hover-primary">
                            <%= relatedPost.title %>
                          </a>
                        </h5>
                        <p class="card-text text-muted small">
                          <%= relatedPost.excerpt.substring(0, 100) %>...
                        </p>
                        <a href="/posts/<%= relatedPost.slug %>" class="btn btn-sm btn-outline-primary">
                          Đọc thêm <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                <% } %>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>
      
      <!-- Sidebar -->
      <div class="col-lg-4">
        <!-- Category -->
        <% if (post.category) { %>
          <div class="sidebar-widget">
            <h5 class="mb-3">Chuyên mục</h5>
            <a href="/posts?category=<%= post.category.id %>" class="btn btn-outline-primary w-100">
              <% if (post.category.icon) { %>
                <i class="<%= post.category.icon %> me-2"></i>
              <% } %>
              <%= post.category.name %>
            </a>
          </div>
        <% } %>
        
        <!-- Latest Posts -->
        <% if (latestPosts && latestPosts.length > 0) { %>
          <div class="sidebar-widget">
            <h5 class="mb-3">Bài viết mới nhất</h5>
            <% latestPosts.forEach(latestPost => { %>
              <% if (latestPost) { %>
                <div class="sidebar-post-item">
                  <img src="<%= latestPost.thumbnail || 'https://source.unsplash.com/160x120/?medical' %>" 
                       alt="<%= latestPost.title %>"
                       class="sidebar-post-thumbnail"
                       onerror="this.src='https://placehold.co/80x60/0066CC/FFFFFF/png?text=News'">
                  <div class="flex-grow-1">
                    <h6 class="mb-1">
                      <a href="/posts/<%= latestPost.slug %>" class="text-decoration-none text-dark hover-primary">
                        <%= latestPost.title.substring(0, 60) %><%= latestPost.title.length > 60 ? '...' : '' %>
                      </a>
                    </h6>
                    <small class="text-muted">
                      <i class="fas fa-calendar me-1"></i>
                      <%= new Date(latestPost.published_at).toLocaleDateString('vi-VN') %>
                    </small>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>
        <% } %>
        
        <!-- Share Buttons -->
        <div class="sidebar-widget">
          <h5 class="mb-3">Chia sẻ bài viết</h5>
          <div class="d-grid gap-2">
            <button class="btn btn-primary" onclick="shareFacebook()">
              <i class="fab fa-facebook me-2"></i>Facebook
            </button>
            <button class="btn btn-info text-white" onclick="shareTwitter()">
              <i class="fab fa-twitter me-2"></i>Twitter
            </button>
            <button class="btn btn-success" onclick="copyLink()">
              <i class="fas fa-link me-2"></i>Copy Link
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- contentFor('additionalScripts') %>
<script>
function shareFacebook() {
  window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(window.location.href), '_blank', 'width=600,height=400');
}

function shareTwitter() {
  window.open('https://twitter.com/intent/tweet?url=' + encodeURIComponent(window.location.href) + '&text=' + encodeURIComponent('<%= post.title %>'), '_blank', 'width=600,height=400');
}

function copyLink() {
  navigator.clipboard.writeText(window.location.href).then(() => {
    alert('Đã copy link bài viết!');
  });
}
</script>
<% -%>
