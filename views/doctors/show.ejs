<div class="bg-light py-5">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/doctors">Bác sĩ</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= doctor.user.full_name %></li>
            </ol>
        </nav>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm text-center p-4">
                    <img src="<%= (doctor.user && doctor.user.avatar) ? doctor.user.avatar : 'https://placehold.co/400x400/e9ecef/6c757d?text=Doctor' %>"
                         class="rounded-circle img-thumbnail shadow-sm mx-auto mb-3"
                         style="width: 180px; height: 180px; object-fit: cover;">

                    <h4 class="fw-bold mb-1"><%= doctor.user.full_name %></h4>
                    <p class="text-primary fw-bold mb-3">
                        <%= doctor.specialty ? doctor.specialty.name : 'Đa khoa' %>
                    </p>

                    <div class="d-grid gap-2 mt-2">
                        <a href="/appointments/booking" class="btn btn-primary btn-lg shadow-sm">
                            <i class="fas fa-calendar-check me-2"></i>Đặt lịch khám
                        </a>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Thông tin liên hệ</h6>
                        <ul class="list-unstyled mb-0 text-muted small">
                            <li class="mb-2"><i class="fas fa-envelope me-2 width-20"></i> <%= doctor.user.email %></li>
                            <li class="mb-2"><i class="fas fa-phone me-2 width-20"></i> <%= doctor.user.phone || 'Đang cập nhật' %></li>
                            <li><i class="fas fa-map-marker-alt me-2 width-20"></i> <%= doctor.clinic_address || 'Bệnh viện Đa khoa' %></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold border-bottom pb-2 mb-3">Giới thiệu</h5>
                        <p class="text-muted"><%= doctor.description || 'Bác sĩ chưa cập nhật thông tin giới thiệu.' %></p>

                        <h5 class="fw-bold border-bottom pb-2 mb-3 mt-4">Kinh nghiệm & Đào tạo</h5>
                        <p class="text-muted">
                            <i class="fas fa-check-circle text-success me-2"></i>Tốt nghiệp Đại học Y Dược<br>
                            <i class="fas fa-check-circle text-success me-2"></i>Chứng chỉ hành nghề chuyên khoa<br>
                            <i class="fas fa-check-circle text-success me-2"></i>Nhiều năm kinh nghiệm công tác tại các bệnh viện lớn
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>