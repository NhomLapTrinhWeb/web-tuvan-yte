<div class="bg-light py-5">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/specialties">Chuyên khoa</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= specialty.name %></li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-8 mx-auto text-center mb-5">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                    <i class="fas fa-heartbeat fa-3x text-primary"></i>
                </div>
                <h1 class="fw-bold text-primary mb-3"><%= specialty.name %></h1>
                <p class="lead text-muted"><%= specialty.description || 'Thông tin chi tiết về khoa đang được cập nhật.' %></p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <h3 class="fw-bold border-start border-4 border-primary ps-3 mb-4">Đội Ngũ Bác Sĩ</h3>
            </div>

            <% if (specialty.doctors && specialty.doctors.length > 0) { %>
                <% specialty.doctors.forEach(doctor => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body text-center p-4">
                                <img src="<%= (doctor.user && doctor.user.avatar) ? doctor.user.avatar : 'https://placehold.co/400x400/e9ecef/6c757d?text=BS' %>"
                                     class="rounded-circle img-thumbnail mb-3" style="width: 120px; height: 120px; object-fit: cover;">
                                <h5 class="fw-bold"><%= doctor.user.full_name %></h5>
                                <p class="text-primary small mb-3"><%= specialty.name %></p>

                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/doctors/<%= doctor.id %>" class="btn btn-outline-primary btn-sm rounded-pill">Hồ sơ</a>
                                    <a href="/appointments/booking" class="btn btn-primary btn-sm rounded-pill">Đặt lịch</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-4 bg-white rounded shadow-sm">
                    <p class="text-muted mb-0">Hiện chưa có bác sĩ nào thuộc khoa này.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>