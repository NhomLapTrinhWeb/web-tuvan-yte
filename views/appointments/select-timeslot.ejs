<div class="container my-5">
  <div class="row mb-4">
    <div class="col-12">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/appointments/book">Chọn bác sĩ</a></li>
          <li class="breadcrumb-item active">Chọn giờ khám</li>
        </ol>
      </nav>
      <h2 class="mb-3">Chọn Giờ Khám</h2>
      <p class="text-muted">Bước 2/3: Chọn thời gian phù hợp</p>
    </div>
  </div>

  <!-- Doctor Info -->
  <div class="card mb-4">
    <div class="card-body">
      <div class="d-flex align-items-center">
        <img src="<%= doctor.user.avatar || 'https://placehold.co/80x80/0066CC/FFFFFF/png?text=Dr' %>" 
             alt="<%= doctor.user.full_name %>"
             class="rounded-circle me-3"
             style="width: 80px; height: 80px; object-fit: cover;">
        <div>
          <h4 class="mb-1"><%= doctor.user.full_name %></h4>
          <% if (doctor.specialty) { %>
            <p class="text-muted mb-0"><%= doctor.specialty.name %></p>
          <% } %>
          <div class="text-primary">
            <strong><%= doctor.consultation_price ? doctor.consultation_price.toLocaleString('vi-VN') + 'đ' : 'Liên hệ' %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Time Slots -->
  <% if (Object.keys(slotsByDate).length > 0) { %>
    <% Object.keys(slotsByDate).forEach(date => { %>
      <div class="card mb-3">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <%= new Date(date).toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-2">
            <% slotsByDate[date].forEach(slot => { %>
              <div class="col-md-2 col-sm-3 col-6">
                <a href="/appointments/book/<%= doctor.id %>/confirm?slot_id=<%= slot.id %>" 
                   class="btn btn-outline-primary w-100 <%= slot.hasAvailability() ? '' : 'disabled' %>">
                  <%= slot.start_time.substring(0, 5) %> - <%= slot.end_time.substring(0, 5) %>
                  <% if (!slot.hasAvailability()) { %>
                    <br><small class="text-muted">Đã đầy</small>
                  <% } %>
                </a>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="card">
      <div class="card-body text-center py-5">
        <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
        <p class="text-muted">Bác sĩ chưa có lịch khám trong 7 ngày tới</p>
        <a href="/appointments/book" class="btn btn-primary mt-3">
          <i class="fas fa-arrow-left me-2"></i>Chọn bác sĩ khác
        </a>
      </div>
    </div>
  <% } %>
</div>
